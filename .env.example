# Docker Compose production configuration. Copy to .env and replace placeholders.
POSTGRES_DB=legal_lexai
POSTGRES_USER=legal
POSTGRES_PASSWORD=replace-with-a-strong-password
WEB_PORT=3000
API_PORT=8000

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=replace-with-your-jwt-secret
SUPABASE_KEY=replace-with-your-service-role-key
GEMINI_API_KEY=replace-with-your-gemini-key
CORS_ORIGINS=https://app.example.com

# Public values are baked into the production Next.js image at build time.
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-anon-key
